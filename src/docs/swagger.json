{
	"openapi": "3.0.3",
	"info": {
		"title": "GrowTweet API",
		"description": "Public endpoints to integrate with GrowTweet service",
		"version": "1.0.0"
	},
	"paths": {
		"/auth/login" : {
			"post": {
				"description": "Log in and return the access token",
				"tags": ["Auth"],
				"parameters": [],
				"requestBody": {
					"description": "User credentials",
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"email": {
										"type": "string",
										"example": "user@example.com"
									},
									"password": {
										"type": "string"
									}
								},
								"required": ["email", "password"]
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Successfull login",
						"content": {
							"application/json": {
								"schema": {
									"allOf" : [
										{"$ref": "#/components/schemas/defaultResponse"},
										{
											"properties": {
												"data": {
													"type": "string",
													"description": "JWT token"
												}
											}
										}
									]
								}
							}
						}
					},
					"400": {
						"description": "Some of the credential fields is missing or user does not exist",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/defaultResponse"
								}
							}
						}
					},
					"500": {
						"description": "Unknown server error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/defaultResponse"
								}
							}
						}
					}
				}
			}
		},
		"/like/{tweetId}": {
			"description": "'Like' functionality",
			"parameters": [
				{
					"schema": {},
					"name": "tweetId",
					"in": "path",
					"required": true
				}
			],
			"post": {
				"description": "Like a tweet with the current logged user",
				"tags": ["Likes"],
				"parameters": [],
				"responses": {
					"200": {
						"description": "The like was successfully registered",
						"content": {
							"application/json": {
								"schema": {
									"allOf" : [
										{"$ref": "#/components/schemas/defaultResponse"},
										{
											"properties": {
												"data": {
													"$ref": "#/components/schemas/tweet"
												}
											}
										}
									]
								}
							}
						}
					},
					"401": {
						"description": "Unauthorized. Is user logged in?",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/defaultResponse"
								}
							}
						}
					},
					"500": {
						"description": "Unknown server error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/defaultResponse"
								}
							}
						}
					}
				}
			}
		},
		"/visits": {
			"post": {
				"description": "Count one visit for the current UTC day (server clock). Creates the day row with count 1 if it does not exist.",
				"tags": ["Visits"],
				"security": [],
				"parameters": [],
				"responses": {
					"201": {
						"description": "The visit was counted; returns the day row after the increment",
						"content": {
							"application/json": {
								"schema": {
									"allOf": [
										{"$ref": "#/components/schemas/defaultResponse"},
										{ "properties": { "data": { "$ref": "#/components/schemas/DailyVisit" } } }
									]
								}
							}
						}
					},
					"500": {
						"description": "Unknown server error",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/defaultResponse" }
							}
						}
					}
				}
			},
			"get": {
				"description": "List the visit counts of the most recent UTC days that have visits, newest first. Days without visits are not included.",
				"tags": ["Visits"],
				"security": [],
				"parameters": [
					{
						"name": "last",
						"in": "query",
						"required": false,
						"description": "Maximum number of days to return. Defaults to 10; a missing or non-integer value is treated as 10. Values below 1 become 1 and values above 2147483647 become 2147483647. Never causes a 400.",
						"schema": { "type": "integer", "default": 10, "example": 10 }
					}
				],
				"responses": {
					"200": {
						"description": "The most recent day rows, newest first (an empty array when there are none)",
						"content": {
							"application/json": {
								"schema": {
									"allOf": [
										{"$ref": "#/components/schemas/defaultResponse"},
										{ "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/DailyVisit" } } } }
									]
								}
							}
						}
					},
					"500": {
						"description": "Unknown server error",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/defaultResponse" }
							}
						}
					}
				}
			}
		},
		"/visits/total": {
			"get": {
				"description": "Return the all-time number of visits (sum of the counts of every UTC day). Returns 0 when nothing was counted yet.",
				"tags": ["Visits"],
				"security": [],
				"parameters": [],
				"responses": {
					"200": {
						"description": "The all-time visit total",
						"content": {
							"application/json": {
								"schema": {
									"allOf": [
										{"$ref": "#/components/schemas/defaultResponse"},
										{
											"properties": {
												"data": {
													"type": "object",
													"properties": {
														"total": { "description": "All-time number of visits", "type": "integer", "example": 7 }
													}
												}
											}
										}
									]
								}
							}
						}
					},
					"500": {
						"description": "Unknown server error",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/defaultResponse" }
							}
						}
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"tweet": {
				"description": "Basic Like information",
				"type": "object",
				"properties": {
					"tweetId": {
						"description": "The identifier of the tweet that was liked",
						"type": "number"
					},
					"userId": {
						"description": "The identifier of the user that liked that tweet",
						"type": "number"
					}
				}
			},
			"defaultResponse": {
				"description": "Default response format",
				"type": "object",
				"properties": {
					"success": {
						"description": "Tells if the operation was successfull",
						"type": "boolean"
					},
					"statusCode": {
						"description": "The HTTP status code",
						"type": "number"
					},
					"message": {
						"description": "Optional message",
						"type": "string",
						"nullable": true
					}
				}
			},
			"DailyVisit": {
				"description": "Visit count of one UTC day",
				"type": "object",
				"properties": {
					"date": { "description": "UTC calendar day (YYYY-MM-DD)", "type": "string", "format": "date", "example": "2026-11-11" },
					"count": { "description": "Number of visits counted that day", "type": "integer", "example": 1 }
				}
			}
		},
		"securitySchemes": {
			"bearerAuth": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "JWT"
			}
		}
	},
	"tags": [
		{
			"name": "Auth",
			"description": "Endpoints related to authorization"
		},
		{
			"name": "Likes",
			"description": "Endpoints related to Like"
		},
		{
			"name": "Visits",
			"description": "Endpoints related to the visitor counter"
		}
	],
	"security": [
		{ "bearerAuth": [] }
	]
}